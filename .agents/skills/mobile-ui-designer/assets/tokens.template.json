{
  "meta": {
    "appName": "{{USER_APP_NAME}}",
    "platform": "{{USER_PLATFORM}}",
    "themeMode": "{{light|dark|both|system}}",
    "version": "1.0.0"
  },
  "color": {
    "brand": {
      "primary": { "value": "{{USER_PRIMARY_HEX}}", "source": "user" },
      "secondary": { "value": "{{USER_SECONDARY_HEX_OR_DERIVED}}", "source": "user|derived" },
      "accent": { "value": "{{USER_ACCENT_HEX_OR_DERIVED}}", "source": "user|derived" }
    },
    "palette": {
      "primary": {
        "50": "", "100": "", "200": "", "300": "", "400": "",
        "500": "{{USER_PRIMARY_HEX}}",
        "600": "", "700": "", "800": "", "900": ""
      },
      "neutral": {
        "0": "#FFFFFF", "50": "", "100": "", "200": "", "300": "", "400": "",
        "500": "", "600": "", "700": "", "800": "", "900": "", "1000": "#000000"
      }
    },
    "semantic": {
      "light": {
        "bg.base": "", "bg.surface": "", "bg.surfaceAlt": "", "bg.overlay": "rgba(0,0,0,0.5)",
        "text.primary": "", "text.secondary": "", "text.disabled": "", "text.onPrimary": "", "text.link": "",
        "border.default": "", "border.strong": "", "border.focus": "",
        "action.primary": "", "action.primaryPressed": "", "action.primaryDisabled": "",
        "feedback.success": "", "feedback.warning": "", "feedback.error": "", "feedback.info": ""
      },
      "dark": {
        "bg.base": "", "bg.surface": "", "bg.surfaceAlt": "", "bg.overlay": "rgba(0,0,0,0.6)",
        "text.primary": "", "text.secondary": "", "text.disabled": "", "text.onPrimary": "", "text.link": "",
        "border.default": "", "border.strong": "", "border.focus": "",
        "action.primary": "", "action.primaryPressed": "", "action.primaryDisabled": "",
        "feedback.success": "", "feedback.warning": "", "feedback.error": "", "feedback.info": ""
      }
    }
  },
  "typography": {
    "family": {
      "heading": { "value": "{{USER_HEADING_FONT_OR_system}}", "source": "user|default" },
      "body": { "value": "{{USER_BODY_FONT_OR_system}}", "source": "user|default" },
      "mono": { "value": "monospace", "source": "default" }
    },
    "baseSize": { "value": 16, "source": "user|default" },
    "scale": {
      "display": { "size": 34, "lineHeight": 40, "weight": 700 },
      "title1": { "size": 28, "lineHeight": 34, "weight": 700 },
      "title2": { "size": 22, "lineHeight": 28, "weight": 600 },
      "title3": { "size": 20, "lineHeight": 26, "weight": 600 },
      "body": { "size": 16, "lineHeight": 24, "weight": 400 },
      "bodyStrong": { "size": 16, "lineHeight": 24, "weight": 600 },
      "callout": { "size": 15, "lineHeight": 22, "weight": 400 },
      "caption": { "size": 13, "lineHeight": 18, "weight": 400 },
      "overline": { "size": 11, "lineHeight": 16, "weight": 600, "letterSpacing": 0.5, "uppercase": true }
    }
  },
  "spacing": {
    "unit": { "value": 4, "source": "user|default" },
    "scale": { "1": 4, "2": 8, "3": 12, "4": 16, "6": 24, "8": 32, "12": 48 },
    "screenMargin": 16
  },
  "radius": {
    "sm": { "value": 8, "source": "user|default" },
    "md": { "value": 12, "source": "user|default" },
    "lg": { "value": 16, "source": "user|default" },
    "pill": 999
  },
  "elevation": {
    "0": { "shadow": "none" },
    "1": { "shadow": "0 1 3 rgba(0,0,0,0.12)", "darkOverlay": 0.04 },
    "2": { "shadow": "0 2 6 rgba(0,0,0,0.14)", "darkOverlay": 0.06 },
    "3": { "shadow": "0 4 12 rgba(0,0,0,0.16)", "darkOverlay": 0.08 },
    "4": { "shadow": "0 8 24 rgba(0,0,0,0.18)", "darkOverlay": 0.10 }
  },
  "motion": {
    "duration": { "fast": 120, "base": 200, "slow": 320 },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter": "cubic-bezier(0, 0, 0.2, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    }
  },
  "size": {
    "touchMin": 44,
    "controlHeight": 48,
    "icon": { "sm": 16, "md": 24, "lg": 32 }
  },
  "contrastPairs": [
    { "name": "Body text on base", "fg": "text.primary", "bg": "bg.base", "min": 4.5 },
    { "name": "Secondary text on base", "fg": "text.secondary", "bg": "bg.base", "min": 4.5 },
    { "name": "Body text on surface", "fg": "text.primary", "bg": "bg.surface", "min": 4.5 },
    { "name": "Text on primary button", "fg": "text.onPrimary", "bg": "action.primary", "min": 4.5 },
    { "name": "Link on base", "fg": "text.link", "bg": "bg.base", "min": 4.5 },
    { "name": "Focus ring on base", "fg": "border.focus", "bg": "bg.base", "min": 3.0 },
    { "name": "Error on base", "fg": "feedback.error", "bg": "bg.base", "min": 4.5 }
  ]
}
